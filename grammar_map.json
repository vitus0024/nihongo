{
 "_note": "文法地圖（參考蓮先生「9 大助詞／5 大進階助詞／12 種動詞變形」的骨架）。每項用 match（正規式）對到課綱 grammar.pattern；有對到且該課完成 → 已學；有對到未完成 → 在課表裡；沒對到 → 之後的階段。",
 "groups": [
  {"title": "基礎助詞（9）", "items": [
   {"name": "は", "zh": "主題", "match": "N1 は N2 です$|^N は"},
   {"name": "が", "zh": "主語／狀態", "match": "が"},
   {"name": "を", "zh": "動作對象", "match": "N を"},
   {"name": "に", "zh": "時間點／方向／存在", "match": "〜時に|に Vます"},
   {"name": "へ", "zh": "方向", "match": "N へ"},
   {"name": "で", "zh": "工具／場所", "match": "N で"},
   {"name": "と", "zh": "並列／一起", "match": "N1 と N2|N と 行きます"},
   {"name": "も", "zh": "也", "match": "N も|どこ（へ）も"},
   {"name": "の", "zh": "所屬／修飾", "match": "N1 の N2|N のです"}
  ]},
  {"title": "進階助詞（5）", "items": [
   {"name": "から・まで", "zh": "起點・終點", "match": "から N まで"},
   {"name": "から（原因）", "zh": "主觀原因", "match": "から（原因）|〜から、"},
   {"name": "ので", "zh": "客觀原因", "match": "ので(?!す)"},
   {"name": "が（轉折）", "zh": "但是", "match": "〜が、"},
   {"name": "に（頻率）", "zh": "一週三次", "match": "に 〜回"}
  ]},
  {"title": "動詞變形（12）", "items": [
   {"name": "ます形", "zh": "禮貌", "match": "^Vます$|Vますか"},
   {"name": "ない形", "zh": "否定", "match": "Vない"},
   {"name": "辞書形", "zh": "原形", "match": "V辞書形|Vる"},
   {"name": "て形", "zh": "連接・請求", "match": "Vて"},
   {"name": "た形", "zh": "過去", "match": "Vた"},
   {"name": "可能形", "zh": "能夠", "match": "可能形"},
   {"name": "意向形", "zh": "一起吧", "match": "意向形|Vよう"},
   {"name": "ば形", "zh": "如果", "match": "Vば"},
   {"name": "命令形", "zh": "命令", "match": "命令形"},
   {"name": "禁止形", "zh": "不准", "match": "禁止形|Vな$"},
   {"name": "受身形", "zh": "被動", "match": "受身"},
   {"name": "使役形", "zh": "使役", "match": "使役"}
  ]},
  {"title": "名詞句・指示・數量", "items": [
   {"name": "N です／ですか", "zh": "是／是嗎", "match": "N1 は N2 です"},
   {"name": "こそあど（物）", "zh": "這那哪", "match": "これ／それ／あれ|この N"},
   {"name": "こそあど（地）", "zh": "這裡那裡", "match": "ここ／そこ／あそこ|こちら"},
   {"name": "疑問詞", "zh": "何・誰・どこ・いつ・いくら", "match": "何ですか|誰の|どこですか|いつ|いくら|何歳"},
   {"name": "數字・價格", "zh": "0〜万・円", "match": "数字|〜円"},
   {"name": "時間・日期", "zh": "時分・曜日・月日", "match": "〜時〜分|曜日|〜月|〜日"},
   {"name": "語尾 ね・よ", "zh": "共感・告知", "match": "^〜ね$|^〜よ$"}
  ]}
 ]
}
