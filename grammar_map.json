{
 "_note": "文法地圖。骨架對照蓮先生電子書的章節：核心助詞 8（紫本 2.1–2.8 順序）、進階助詞 7（櫻本 2.1–2.7）、動詞 12 形（綠本／金本順序）。每項用 match（正規式）對到課綱 grammar.pattern；有對到且該課完成 → 已學；有對到未完成 → 在課表裡；沒對到 → 之後的階段。說明文字是我們自己的，不引用書中內容。",
 "groups": [
  {
   "title": "核心助詞（8）",
   "items": [
    {
     "name": "は",
     "zh": "主題／主語",
     "match": "N1 は N2 です$|^N は"
    },
    {
     "name": "に",
     "zh": "箭頭：時間點・目的地・對象",
     "match": "〜時に|に Vます"
    },
    {
     "name": "を",
     "zh": "動作作用的對象",
     "match": "N を"
    },
    {
     "name": "と",
     "zh": "全部列舉・一起",
     "match": "N1 と N2|N と 行きます"
    },
    {
     "name": "や",
     "zh": "部分列舉",
     "match": "N1 や N2"
    },
    {
     "name": "が",
     "zh": "狀態・存在的主語",
     "match": "N が (あります|います)|が 好き|が 上手"
    },
    {
     "name": "へ",
     "zh": "方向",
     "match": "N へ"
    },
    {
     "name": "で",
     "zh": "動作的地點・工具手段",
     "match": "N で"
    }
   ]
  },
  {
   "title": "常用補充",
   "items": [
    {
     "name": "も",
     "zh": "也",
     "match": "N も|どこ（へ）も"
    },
    {
     "name": "の",
     "zh": "所屬・修飾",
     "match": "N1 の N2|N のです"
    },
    {
     "name": "か",
     "zh": "疑問",
     "match": "ですか$|Vますか"
    },
    {
     "name": "ね・よ",
     "zh": "共感・告知",
     "match": "^〜ね$|^〜よ$"
    }
   ]
  },
  {
   "title": "進階助詞（7）",
   "items": [
    {
     "name": "が（轉折・前言）",
     "zh": "但是／話說",
     "match": "〜が、"
    },
    {
     "name": "と（反射）",
     "zh": "一…就",
     "match": "Vと、"
    },
    {
     "name": "に（頻率）",
     "zh": "一週三次",
     "match": "に 〜回"
    },
    {
     "name": "から・まで",
     "zh": "起點・終點",
     "match": "から N まで"
    },
    {
     "name": "から（主觀原因）",
     "zh": "因為（自己這麼覺得）",
     "match": "〜から、|から（原因）"
    },
    {
     "name": "ので（客觀原因）",
     "zh": "因為（客觀事實）",
     "match": "ので(?!す)"
    },
    {
     "name": "で（原因）",
     "zh": "因為（外在條件）",
     "match": "N で（原因）"
    }
   ]
  },
  {
   "title": "動詞 12 形（綠本→金本順序）",
   "items": [
    {
     "name": "ない形",
     "zh": "否定意志",
     "match": "Vない"
    },
    {
     "name": "ます形",
     "zh": "禮貌",
     "match": "^Vます$|Vますか"
    },
    {
     "name": "原形",
     "zh": "字典上的樣子",
     "match": "V辞書形|V原形|Vる"
    },
    {
     "name": "可能形",
     "zh": "能夠・會",
     "match": "可能形"
    },
    {
     "name": "て形",
     "zh": "連接・請求",
     "match": "Vて"
    },
    {
     "name": "た形",
     "zh": "過去",
     "match": "Vた"
    },
    {
     "name": "禁止形",
     "zh": "不准",
     "match": "禁止形|Vな$"
    },
    {
     "name": "ば形",
     "zh": "如果…的話",
     "match": "Vば"
    },
    {
     "name": "命令形",
     "zh": "命令",
     "match": "命令形"
    },
    {
     "name": "受身形",
     "zh": "被動・客觀語氣",
     "match": "受身"
    },
    {
     "name": "使役形",
     "zh": "讓／叫某人做",
     "match": "使役"
    },
    {
     "name": "意向形",
     "zh": "一起…吧・我的意志",
     "match": "意向形|Vよう"
    }
   ]
  },
  {
   "title": "名詞句・指示・數量（第 1 階段）",
   "items": [
    {
     "name": "N です／ですか",
     "zh": "是／是嗎",
     "match": "N1 は N2 です"
    },
    {
     "name": "こそあど（物）",
     "zh": "這那哪",
     "match": "これ／それ／あれ|この N"
    },
    {
     "name": "こそあど（地）",
     "zh": "這裡那裡",
     "match": "ここ／そこ／あそこ|こちら"
    },
    {
     "name": "疑問詞",
     "zh": "何・誰・どこ・いつ・いくら",
     "match": "何ですか|誰の|どこですか|いつ|いくら|何歳"
    },
    {
     "name": "數字・價格",
     "zh": "0〜万・円",
     "match": "数字|〜円"
    },
    {
     "name": "時間・日期",
     "zh": "時分・曜日・月日",
     "match": "〜時〜分|曜日|〜月|〜日"
    }
   ]
  }
 ]
}