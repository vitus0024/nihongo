  "text": "島へ船で行きます。",
  "profile": 1,
  "backend": "openai"
 },
 "line.9": {
  "file": "9c4a890b252a.mp3",
  "text": "「これは島の地図です。",
  "profile": 1,
  "backend": "openai"
 },
